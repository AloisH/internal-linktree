# Copy to .env for local development. Nuxt maps NUXT_* onto runtimeConfig;
# the boot plugin refuses to start without a usable NUXT_AUTH_SECRET.

# Signs sessions and OIDC tokens (32+ chars). Generate: openssl rand -base64 32
NUXT_AUTH_SECRET=changeme-dev-secret-changeme-dev-secret

# First admin account, created at boot while the user table is empty.
# Remove or ignore once it exists; manage accounts from /admin/users.
NUXT_ADMIN_EMAIL=admin@example.com
NUXT_ADMIN_PASSWORD=changeme-dev-password

# SQLite file (created on first boot, WAL mode). In Docker: /app/data/app.db
NUXT_DB_PATH=./data/app.db

# Uploaded files (created on first upload). In Docker: /app/data/uploads
NUXT_UPLOADS_DIR=./data/uploads

# Self sign-up for addresses ending in this domain (e.g. clinique.fr), with
# the "utilisateur" role. Leave empty to let only admins create accounts.
NUXT_PUBLIC_SIGNUP_EMAIL_DOMAIN=example.com

# Escape hatch for an internal network without TLS: hosts or IPs (comma
# separated) that declared applications may use with http:// redirect URLs.
# Sessions and tokens then travel in clear on that network. Empty: https only.
NUXT_PUBLIC_INSECURE_REDIRECT_HOSTS=

# Canonical URL (og/sitemap-style metadata)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Branding shown on the portal
NUXT_PUBLIC_SITE_NAME=Portail interne
NUXT_PUBLIC_SITE_TAGLINE=Applications et documents de l’établissement, au même endroit.

# ── Production only (docker compose) ─────────────────────────────
#DOMAIN=example.com
#GHCR_OWNER=AloisH
#APP_TAG=latest
